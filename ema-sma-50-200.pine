//@version=6
// Created by Kai Engels, based on the script from Robert Nance.
// Skriptversion: 1
// Bei jeder Skriptänderung die Skriptversion um 1 erhöhen.
indicator("Kais EMA/SMA 50/200", shorttitle = "Kais MAs", overlay = true)

const color sma50Color  = #C8E6C9
const color ema50Color  = #4CAF50
const color sma200Color = #00BCD4
const color ema200Color = #2962FF

const string chartGroup  = "Durchschnitte im aktuellen Chart"
const string levelsGroup = "Horizontale Linien"

bool showSma50   = input.bool(true, "SMA 50", inline = "sma50", group = chartGroup)
int sma50Length  = input.int(50, "Länge", inline = "sma50", group = chartGroup, minval = 1)
bool showEma50   = input.bool(true, "EMA 50", inline = "ema50", group = chartGroup)
int ema50Length  = input.int(50, "Länge", inline = "ema50", group = chartGroup, minval = 1)
bool showSma200  = input.bool(true, "SMA 200", inline = "sma200", group = chartGroup)
int sma200Length = input.int(200, "Länge", inline = "sma200", group = chartGroup, minval = 1)
bool showEma200  = input.bool(true, "EMA 200", inline = "ema200", group = chartGroup)
int ema200Length = input.int(200, "Länge", inline = "ema200", group = chartGroup, minval = 1)

bool show1h = input.bool(false, "1 Stunde", group = levelsGroup)
bool showSma50_1h = input.bool(true, "SMA 50", inline = "sma50_1h", group = levelsGroup, active = show1h) and show1h
bool showSma200_1h = input.bool(true, "SMA 200", inline = "sma200_1h", group = levelsGroup, active = show1h) and show1h
bool showEma50_1h = input.bool(true, "EMA 50", inline = "ema50_1h", group = levelsGroup, active = show1h) and show1h
bool showEma200_1h = input.bool(true, "EMA 200", inline = "ema200_1h", group = levelsGroup, active = show1h) and show1h

bool show4h = input.bool(false, "4 Stunden", group = levelsGroup)
bool showSma50_4h = input.bool(true, "SMA 50", inline = "sma50_4h", group = levelsGroup, active = show4h) and show4h
bool showSma200_4h = input.bool(true, "SMA 200", inline = "sma200_4h", group = levelsGroup, active = show4h) and show4h
bool showEma50_4h = input.bool(true, "EMA 50", inline = "ema50_4h", group = levelsGroup, active = show4h) and show4h
bool showEma200_4h = input.bool(true, "EMA 200", inline = "ema200_4h", group = levelsGroup, active = show4h) and show4h

bool show1d = input.bool(false, "Tag", group = levelsGroup)
bool showSma50_1d = input.bool(true, "SMA 50", inline = "sma50_1d", group = levelsGroup, active = show1d) and show1d
bool showSma200_1d = input.bool(true, "SMA 200", inline = "sma200_1d", group = levelsGroup, active = show1d) and show1d
bool showEma50_1d = input.bool(true, "EMA 50", inline = "ema50_1d", group = levelsGroup, active = show1d) and show1d
bool showEma200_1d = input.bool(true, "EMA 200", inline = "ema200_1d", group = levelsGroup, active = show1d) and show1d

color sma50_1hColor = input.color(sma50Color, "", inline = "sma50_1h", group = levelsGroup, active = show1h)
color sma200_1hColor = input.color(sma200Color, "", inline = "sma200_1h", group = levelsGroup, active = show1h)
color ema50_1hColor = input.color(ema50Color, "", inline = "ema50_1h", group = levelsGroup, active = show1h)
color ema200_1hColor = input.color(ema200Color, "", inline = "ema200_1h", group = levelsGroup, active = show1h)

color sma50_4hColor = input.color(sma50Color, "", inline = "sma50_4h", group = levelsGroup, active = show4h)
color sma200_4hColor = input.color(sma200Color, "", inline = "sma200_4h", group = levelsGroup, active = show4h)
color ema50_4hColor = input.color(ema50Color, "", inline = "ema50_4h", group = levelsGroup, active = show4h)
color ema200_4hColor = input.color(ema200Color, "", inline = "ema200_4h", group = levelsGroup, active = show4h)

color sma50_1dColor = input.color(sma50Color, "", inline = "sma50_1d", group = levelsGroup, active = show1d)
color sma200_1dColor = input.color(sma200Color, "", inline = "sma200_1d", group = levelsGroup, active = show1d)
color ema50_1dColor = input.color(ema50Color, "", inline = "ema50_1d", group = levelsGroup, active = show1d)
color ema200_1dColor = input.color(ema200Color, "", inline = "ema200_1d", group = levelsGroup, active = show1d)

float sma50  = ta.sma(close, sma50Length)
float ema50  = ta.ema(close, ema50Length)
float sma200 = ta.sma(close, sma200Length)
float ema200 = ta.ema(close, ema200Length)

plot(showSma50  ? sma50  : na, title = "SMA 50",  color = sma50Color,  linewidth = 1)
plot(showEma50  ? ema50  : na, title = "EMA 50",  color = ema50Color,  linewidth = 1)
plot(showSma200 ? sma200 : na, title = "SMA 200", color = sma200Color, linewidth = 2)
plot(showEma200 ? ema200 : na, title = "EMA 200", color = ema200Color, linewidth = 2)

// Berechnung aus Schlusskursen des jeweiligen Zeitrahmens.
getLevels(string sourceTimeframe) =>
    request.security(
        syminfo.tickerid, sourceTimeframe,
        [ta.sma(close, 50), ta.ema(close, 50),
         ta.sma(close, 200), ta.ema(close, 200)],
        gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

[sma50_1h, ema50_1h, sma200_1h, ema200_1h] = getLevels("60")
[sma50_4h, ema50_4h, sma200_4h, ema200_4h] = getLevels("240")
[sma50_1d, ema50_1d, sma200_1d, ema200_1d] = getLevels("1D")

// Die Schriftfarbe richtet sich nach der Helligkeit des Label-Hintergrunds.
drawLevelLabel(float price, string caption, color labelColor) =>
    if barstate.islast and not na(price)
        int labelBar = bar_index + 1
        float brightness = 0.2126 * color.r(labelColor) + 0.7152 * color.g(labelColor) + 0.0722 * color.b(labelColor)
        color textColor = brightness >= 140 ? #000000 : color.white
        var label levelLabel = label.new(
            labelBar, price, caption, xloc = xloc.bar_index,
            style = label.style_label_left, color = labelColor,
            textcolor = textColor, size = size.small)
        label.set_xy(levelLabel, labelBar, price)

float sma50_1hLevel = showSma50_1h ? sma50_1h : na
float ema50_1hLevel = showEma50_1h ? ema50_1h : na
float sma200_1hLevel = showSma200_1h ? sma200_1h : na
float ema200_1hLevel = showEma200_1h ? ema200_1h : na

float sma50_4hLevel = showSma50_4h ? sma50_4h : na
float ema50_4hLevel = showEma50_4h ? ema50_4h : na
float sma200_4hLevel = showSma200_4h ? sma200_4h : na
float ema200_4hLevel = showEma200_4h ? ema200_4h : na

float sma50_1dLevel = showSma50_1d ? sma50_1d : na
float ema50_1dLevel = showEma50_1d ? ema50_1d : na
float sma200_1dLevel = showSma200_1d ? sma200_1d : na
float ema200_1dLevel = showEma200_1d ? ema200_1d : na

// Der letzte Plotwert zeichnet das Niveau und sein gleichfarbiges Preislabel.
plot(sma50_1hLevel, "1H SMA 50", sma50_1hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema50_1hLevel, "1H EMA 50", ema50_1hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(sma200_1hLevel, "1H SMA 200", sma200_1hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema200_1hLevel, "1H EMA 200", ema200_1hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)

plot(sma50_4hLevel, "4H SMA 50", sma50_4hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema50_4hLevel, "4H EMA 50", ema50_4hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(sma200_4hLevel, "4H SMA 200", sma200_4hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema200_4hLevel, "4H EMA 200", ema200_4hColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)

plot(sma50_1dLevel, "1D SMA 50", sma50_1dColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema50_1dLevel, "1D EMA 50", ema50_1dColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(sma200_1dLevel, "1D SMA 200", sma200_1dColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)
plot(ema200_1dLevel, "1D EMA 200", ema200_1dColor, linewidth = 1,
    trackprice = true, editable = false, show_last = 1, display = display.pane + display.price_scale)

drawLevelLabel(sma50_1hLevel, "1H SMA 50", sma50_1hColor)
drawLevelLabel(ema50_1hLevel, "1H EMA 50", ema50_1hColor)
drawLevelLabel(sma200_1hLevel, "1H SMA 200", sma200_1hColor)
drawLevelLabel(ema200_1hLevel, "1H EMA 200", ema200_1hColor)

drawLevelLabel(sma50_4hLevel, "4H SMA 50", sma50_4hColor)
drawLevelLabel(ema50_4hLevel, "4H EMA 50", ema50_4hColor)
drawLevelLabel(sma200_4hLevel, "4H SMA 200", sma200_4hColor)
drawLevelLabel(ema200_4hLevel, "4H EMA 200", ema200_4hColor)

drawLevelLabel(sma50_1dLevel, "1D SMA 50", sma50_1dColor)
drawLevelLabel(ema50_1dLevel, "1D EMA 50", ema50_1dColor)
drawLevelLabel(sma200_1dLevel, "1D SMA 200", sma200_1dColor)
drawLevelLabel(ema200_1dLevel, "1D EMA 200", ema200_1dColor)

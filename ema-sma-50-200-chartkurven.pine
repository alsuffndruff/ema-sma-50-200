//@version=6
// Created by Kai Engels, based on the script from Robert Nance.
indicator("Kais EMA/SMA 50/200 Chartkurven V4", shorttitle = "Kurven V4", overlay = true)

const color sma50Color  = #C8E6C9
const color ema50Color  = #4CAF50
const color sma200Color = #00BCD4
const color ema200Color = #2962FF

const string chartGroup  = "Durchschnitte im aktuellen Chart"
bool showSma50   = input.bool(true, "SMA 50", inline = "sma50", group = chartGroup)
int sma50Length  = input.int(50, "Länge", inline = "sma50", group = chartGroup, minval = 1)
bool showEma50   = input.bool(true, "EMA 50", inline = "ema50", group = chartGroup)
int ema50Length  = input.int(50, "Länge", inline = "ema50", group = chartGroup, minval = 1)
bool showSma200  = input.bool(true, "SMA 200", inline = "sma200", group = chartGroup)
int sma200Length = input.int(200, "Länge", inline = "sma200", group = chartGroup, minval = 1)
bool showEma200  = input.bool(true, "EMA 200", inline = "ema200", group = chartGroup)
int ema200Length = input.int(200, "Länge", inline = "ema200", group = chartGroup, minval = 1)

float sma50  = ta.sma(close, sma50Length)
float ema50  = ta.ema(close, ema50Length)
float sma200 = ta.sma(close, sma200Length)
float ema200 = ta.ema(close, ema200Length)

plot(showSma50  ? sma50  : na, title = "SMA 50",  color = sma50Color,  linewidth = 1)
plot(showEma50  ? ema50  : na, title = "EMA 50",  color = ema50Color,  linewidth = 1)
plot(showSma200 ? sma200 : na, title = "SMA 200", color = sma200Color, linewidth = 2)
plot(showEma200 ? ema200 : na, title = "EMA 200", color = ema200Color, linewidth = 2)
